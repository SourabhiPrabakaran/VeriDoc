# =====================================================================
# VeriDoc Workstation Environment Configuration Template
# =====================================================================
# Copy this file to 'backend/.env' to configure the backend service:
#   cp .env.example backend/.env

# ---------------------------------------------------------------------
# Deep Learning Model Configuration
# ---------------------------------------------------------------------
# Path to the serialized PyTorch weights (.pth) relative to backend/
# If left blank or non-existent, the application runs in UNCONFIGURED mode.
DEEPFAKE_MODEL_PATH=training/weights/meso_inception_best.pth
DEEPFAKE_MODEL_NAME=MesoInception-4
DEEPFAKE_MODEL_VERSION=sdfvd_v1
DEEPFAKE_DEVICE=cpu

# ---------------------------------------------------------------------
# Decision Threshold & Aggregation Settings
# ---------------------------------------------------------------------
DEEPFAKE_CLASSIFICATION_THRESHOLD=0.50
DEEPFAKE_VIDEO_AGGREGATION_METHOD=fraction_threshold
DEEPFAKE_VIDEO_FAKE_RATIO_THRESHOLD=0.25
DEEPFAKE_BATCH_SIZE=16

# ---------------------------------------------------------------------
# Video Preprocessing Settings
# ---------------------------------------------------------------------
VIDEO_SAMPLE_INTERVAL_SECONDS=1.0
