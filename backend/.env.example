# =====================================================================
# VeriDoc Workstation Environment Configuration Template
# =====================================================================
# Copy this file to 'backend/.env' (or '.env') to configure the workstation:
#   cp backend/.env.example backend/.env

# ---------------------------------------------------------------------
# Deep Learning Model Configuration
# ---------------------------------------------------------------------
# DEEPFAKE_MODEL_PATH:
#   Path to the serialized PyTorch weights (.pth). Can be relative to backend/
#   or an absolute path.
#   Example: training/weights/meso_inception_best.pth
#   NOTE: Model weights are not tracked in git. If the specified file does
#   not exist or is left blank, the application operates in safe
#   UNCONFIGURED mode without crashing (reporting MODEL_NOT_CONFIGURED).
DEEPFAKE_MODEL_PATH=training/weights/meso_inception_best.pth

# DEEPFAKE_MODEL_NAME:
#   The model architecture to load. Supported options:
#     - MesoInception-4 (Default production spatial baseline)
#     - DualStreamForensicNet (Experimental spatial-spectral multi-stream)
DEEPFAKE_MODEL_NAME=MesoInception-4

# DEEPFAKE_MODEL_VERSION:
#   Identifier for the loaded model checkpoint. Set to "NOT_CONFIGURED"
#   to deliberately bypass neural inference.
DEEPFAKE_MODEL_VERSION=sdfvd_v1

# DEEPFAKE_DEVICE:
#   Execution hardware target: 'cpu' or 'cuda'.
DEEPFAKE_DEVICE=cpu

# ---------------------------------------------------------------------
# Decision Threshold & Aggregation Settings
# ---------------------------------------------------------------------
# DEEPFAKE_CLASSIFICATION_THRESHOLD:
#   Continuous probability cutoff separating REAL (>= threshold) from FAKE (< threshold).
#   Standard cutoff: 0.50
DEEPFAKE_CLASSIFICATION_THRESHOLD=0.50

# DEEPFAKE_VIDEO_AGGREGATION_METHOD:
#   Strategy to aggregate multiple facial crops into a single video decision:
#     - fraction_threshold: Flags video as FAKE if the ratio of fake crops exceeds threshold.
#     - mean_probability: Averages crop probabilities across all sampled frames.
DEEPFAKE_VIDEO_AGGREGATION_METHOD=fraction_threshold

# DEEPFAKE_VIDEO_FAKE_RATIO_THRESHOLD:
#   Proportion of fake crops required to classify an entire video as FAKE.
DEEPFAKE_VIDEO_FAKE_RATIO_THRESHOLD=0.25

# DEEPFAKE_BATCH_SIZE:
#   Mini-batch size for facial crop inference.
DEEPFAKE_BATCH_SIZE=16

# ---------------------------------------------------------------------
# Video Preprocessing Settings
# ---------------------------------------------------------------------
# VIDEO_SAMPLE_INTERVAL_SECONDS:
#   Temporal sampling frequency: extracts 1 candidate frame every N seconds.
VIDEO_SAMPLE_INTERVAL_SECONDS=1.0

# ---------------------------------------------------------------------
# Network & CORS Settings
# ---------------------------------------------------------------------
# ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
